# Copy to .env.local (git-ignored) and fill in only what you need. Never commit real values.
# The app also works with NO env vars: loopback only, DRY_RUN on, no AI calls.

MONO_HOST=127.0.0.1
MONO_PORT=8787
# Required (>= 16 chars) if MONO_HOST is anything but loopback, e.g. when reaching MONO HQ from your phone.
MONO_ACCESS_TOKEN=
MONO_DATA_DIR=

# Guardrails (application settings – NOT Anthropic billing limits). Editable later in the System screen.
DRY_RUN=true
MAX_DAILY_COST_USD=2
MAX_MONTHLY_COST_USD=25
MAX_CONCURRENT_AI_JOBS=2
MAX_JOB_MINUTES=12
MAX_RETRIES=1

# Path to the Claude Code CLI (default: `claude` from PATH). Authenticate it yourself with `claude` / `claude setup-token`.
CLAUDE_BIN=
