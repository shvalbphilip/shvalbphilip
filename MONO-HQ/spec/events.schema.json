{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mono.local/schemas/agent-event.schema.json",
  "title": "MONO HQ public activity event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "runId",
    "agentId",
    "type",
    "occurredAt",
    "publicSummary",
    "origin",
    "isDemo"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "enum": [
        "mono",
        "scout",
        "ledger",
        "flow",
        "credit",
        "budget",
        "radar",
        "guardian"
      ]
    },
    "type": {
      "enum": [
        "queued",
        "started",
        "tool_started",
        "tool_completed",
        "progress",
        "awaiting_input",
        "awaiting_approval",
        "completed",
        "failed",
        "cancelled",
        "paused",
        "heartbeat",
        "skipped",
        "blocked"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "publicSummary": {
      "type": "string",
      "maxLength": 240
    },
    "origin": {
      "enum": [
        "claude-hook",
        "agent-sdk",
        "claude-cli",
        "scheduler",
        "local-rules",
        "user",
        "demo"
      ]
    },
    "isDemo": {
      "type": "boolean"
    },
    "toolCategory": {
      "type": "string",
      "maxLength": 60
    },
    "modelId": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "estimatedCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "actualCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    }
  },
  "description": "Public (redacted) activity event. Stored append-only in SQLite; DEMO events have origin=demo and isDemo=true and are never mixed into real mode. 'seq' is assigned by the server."
}
